---
import ActionButton from '@/components/ActionButton.astro';
import Chip from '@/components/Chip.astro';
import PixelIcon from '@/components/PixelIcon.astro';
import View from '@/components/View.astro';
import ViewTitle from '@/components/ViewTitle.astro';
import VisitedMark from '@/components/VisitedMark.astro';
import { CATEGORY_LABELS, type Project, STATUS_LABELS } from '@/data/projects.ts';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const titleId = `proyecto-${project.id}`;
---

<View data-view="project" data-project-id={project.id} aria-labelledby={titleId}>
  <header class="mb-2.5">
    <ViewTitle id={titleId} level={3}>{project.name}</ViewTitle>
    <p class="flex flex-wrap items-center gap-2">
      <Chip status={project.status}>{STATUS_LABELS[project.status]}</Chip>
      <Chip tone="quiet">{CATEGORY_LABELS[project.category]}</Chip>
      <VisitedMark projectId={project.id} />
    </p>
  </header>

  <p class="leading-snug">{project.description}</p>

  {
    project.highlights.length > 0 && (
      <ul class="my-2.75 flex flex-col gap-0.75" aria-label="Lo más destacado">
        {project.highlights.map((highlight) => (
          <li class="relative pl-4 before:absolute before:top-2 before:left-0.5 before:size-1.5 before:bg-ice">
            {highlight}
          </li>
        ))}
      </ul>
    )
  }

  {
    project.stack.length > 0 && (
      <ul class="flex flex-wrap gap-1.5" aria-label="Tecnologías">
        {project.stack.map((tech) => (
          <Chip as="li" tone="tech">
            {tech}
          </Chip>
        ))}
      </ul>
    )
  }

  <div class="mt-3.5 flex flex-wrap gap-1.75">
    {
      project.liveUrl && (
        <ActionButton href={project.liveUrl} primary target="_blank" rel="noopener noreferrer">
          <PixelIcon name="external" />
          Ver sitio <span class="sr-only">(se abre en otra pestaña)</span>
        </ActionButton>
      )
    }
    {
      project.repoUrl && (
        <ActionButton href={project.repoUrl} target="_blank" rel="noopener noreferrer">
          <PixelIcon name="code" />
          Ver código <span class="sr-only">(se abre en otra pestaña)</span>
        </ActionButton>
      )
    }
    <ActionButton class="no-js:hidden!" data-walk-to={project.id}>
      <PixelIcon name="map" />
      Ir al edificio
    </ActionButton>
  </div>
</View>
