---
import { navItems } from "@/data/web/navegation.ts" 

 
 const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/"
 const isActive = (href: string) => 
    pathname === href || (href !== "/" && pathname.startsWith(`${href}/`))
---

<section class="relative isolate w-full px-40.25 h-screen flex flex-col bg-[url('/hero_wallpaper.avif')] bg-cover bg-center bg-no-repeat">
    <div class="absolute inset-0 -z-10 bg-black/40" aria-hidden="true"></div>
    <nav class="w-full h-37.5 flex flex-row justify-between items-center">
        <div class="flex flex-row gap-4 items-center">
            <a href="/" class="opacity-80 hover:opacity-100 transition-opacity duration-300">
                <img src="/logo.png" alt="Logo" class="w-40 h-24" />
            </a>
        </div>
        <div class="flex flex-row gap-4 bg-[#D9D9D9]/20 backdrop-blur-2xl border border-transparent rounded-xl">
            {
                navItems.map((item) => (
                    <a href={item.href}
                     aria-current={isActive(item.href) ? "page" : undefined}
                     class={`text-lg px-6 py-3 rounded-xl transition-colors hover:text-blue-500 ${isActive(item.href) ? "bg-[#FFFFFF]/50 text-abyss" : ""}`}>
                         {item.label}
                    </a>
                ))
            }
        </div>
    </nav>

    <div id="pantalla-tactil" tabindex="-1" class="flex flex-row items-center mt-20 focus:outline-none">
        <div class="flex flex-col flex-1">
            <h1 class="text-[80px] leading-16">Portfolio Dev</h1>
            <span class="text-3xl">Explora mis proyectos de forma <br />interactica</span>
        </div>

        <div class="w-56 flex flex-col items-center justify-center flex-1">
            <div class="border border-transparent bg-[#FFFFFF]/50 backdrop-blur-2xl opacity-40 rounded-xl w-180 h-110">

            </div>
        </div>
    </div>
</section>