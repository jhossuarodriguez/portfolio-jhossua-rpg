---
/**
 * Íconos de 8×8 dibujados con rectángulos: nítidos a cualquier escala.
 * Son decorativos (aria-hidden): el texto del botón o enlace dice qué hace.
 */
export const ICONS = {
  projects: ['..####..', '..#..#..', '########', '#......#', '###..###', '#......#', '########', '........'],
  map: ['..####..', '.#....#.', '#..##..#', '#..##..#', '.#....#.', '..#..#..', '...##...', '........'],
  person: ['..####..', '..####..', '..####..', '...##...', '.######.', '#.####.#', '..#..#..', '..#..#..'],
  star: ['...##...', '...##...', '########', '.######.', '..####..', '.##..##.', '.#....#.', '........'],
  mail: ['........', '########', '##....##', '#.#..#.#', '#..##..#', '#......#', '########', '........'],
  gear: ['...##...', '.######.', '.##..##.', '###..###', '###..###', '.##..##.', '.######.', '...##...'],
  back: ['...#....', '..##....', '.#######', '########', '.#######', '..##....', '...#....', '........'],
  home: ['...##...', '..####..', '.######.', '########', '.#....#.', '.#.##.#.', '.#.##.#.', '.######.'],
  external: ['....####', '......##', '.....#.#', '#...#..#', '#..#....', '#.......', '#.......', '######..'],
  code: ['########', '#......#', '#.#....#', '#..#...#', '#.#.##.#', '#......#', '########', '........'],
  chat: ['.######.', '#......#', '#.#.#.##', '#......#', '.####.#.', '....##..', '....#...', '........'],
  camera: ['..##....', '########', '#..##..#', '#.#..#.#', '#.#..#.#', '#..##..#', '########', '........'],
  check: ['........', '.......#', '......##', '#....##.', '##..##..', '.####...', '..##....', '........'],
} as const;

export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  /** Por defecto mide 1em y toma el color del texto; `class` reemplaza esas clases. */
  class?: string;
}

const { name, class: className } = Astro.props;

/** Un solo <path> con un rectángulo por cada tramo horizontal de píxeles: HTML mínimo. */
const path = ICONS[name]
  .map((row, y) => {
    const runs: string[] = [];
    let start = -1;
    [...`${row}.`].forEach((cell, x) => {
      if (cell === '#' && start < 0) start = x;
      if (cell !== '#' && start >= 0) {
        runs.push(`M${start} ${y}h${x - start}v1h-${x - start}z`);
        start = -1;
      }
    });
    return runs.join('');
  })
  .join('');
---

<svg
  class={className ?? 'size-[1em] flex-none fill-current'}
  viewBox="0 0 8 8"
  width="16"
  height="16"
  aria-hidden="true"
  focusable="false"
  shape-rendering="crispEdges"
>
  <path d={path} />
</svg>
