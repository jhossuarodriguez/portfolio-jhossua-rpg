# Solo para los e2e con agente (`pnpm test:e2e:agent`). e2e no carga este archivo:
# exporta las variables en tu terminal o en los secretos de CI.
AI_GATEWAY_API_KEY=
# Modelo del agente en Vercel AI Gateway (opcional).
E2E_MODEL=openai/gpt-6-luna-fast
# Usar un Chrome instalado en vez del Chromium de Playwright (opcional).
E2E_CHROME_PATH=
# Probar contra un despliegue en vez del build local (opcional).
APP_URL=
